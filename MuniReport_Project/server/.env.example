# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=MuniReportDB
DB_PASSWORD=change_me
DB_PORT=5432

# Used to sign session tokens (HMAC-SHA256). Use a long random string in production,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

PORT=5000
